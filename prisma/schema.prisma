generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Marketplace {
  id      Int       @id @default(autoincrement()) @map("id")
  name    String    @unique @map("name")
  baseUrl String    @map("base_url")
  
  products   Product[]
  sellers    Seller[]
  tasks      SearchTask[]

  @@map("marketplace")
}

model Brand {
  id       Int       @id @default(autoincrement()) @map("id")
  name     String    @unique @map("name")
  products Product[]

  @@map("brand")
}

model SearchTask {
  id            Int            @id @default(autoincrement()) @map("id")
  marketplace   Marketplace    @relation(fields: [marketplaceId], references: [id])
  marketplaceId Int            @map("marketplace_id")
  searchType    String         @map("search_type") // 'query', 'url', 'sku', 'category'
  query         String         @map("query")
  status        String         @default("pending") @map("status")
  createdAt     DateTime       @default(now()) @map("created_at")
  
  priceHistory  PriceHistory[]

  @@map("search_task")
}

model Product {
  id            Int          @id @default(autoincrement()) @map("id")
  marketplace   Marketplace  @relation(fields: [marketplaceId], references: [id])
  marketplaceId Int          @map("marketplace_id")
  brand         Brand        @relation(fields: [brandId], references: [id])
  brandId       Int          @map("brand_id")

  rawCategories String[]     @map("raw_categories")

  categoryId    String?      @map("category_id")   
  category      Category?    @relation(fields: [categoryId], references: [id])
  
  sku           String       @map("sku")
  url           String?      @map("url")
  title         String       @map("title")
  reviewsCount  Int          @default(0) @map("reviews_count")
  rating        Decimal?     @db.Decimal(5, 2) @map("rating")
  imageUrl      String?      @map("image_url")
  createdAt     DateTime     @default(now()) @map("created_at")

  priceHistory  PriceHistory[]
  reviews       Review[]

  @@unique([marketplaceId, sku])
  @@map("product")
}

model Seller {
  id            Int         @id @default(autoincrement()) @map("id")
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id])
  marketplaceId Int         @map("marketplace_id")
  
  merchantId    String      @map("merchant_id") // Стабильный ID из URL (напр. 30366938)
  name          String      @map("name")
  rating        Decimal?    @db.Decimal(5, 2) @map("rating")
  reviewsCount  Int         @default(0) @map("reviews_count")
  phone         String?     @map("phone")
  url           String?     @map("url")
  createdAt     DateTime    @default(now()) @map("created_at")

  priceHistory  PriceHistory[]

  @@unique([marketplaceId, merchantId])
  @@map("seller")
}

model Category {
  id        String     @id @default(uuid()) @map("id")
  name      String     @map("name")
  
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  
  products  Product[]

  @@unique([name, parentId])
  @@map("categories")
}

model PriceHistory {
  id           Int        @id @default(autoincrement()) @map("id")
  task         SearchTask @relation(fields: [taskId], references: [id])
  taskId       Int        @map("task_id")
  product      Product    @relation(fields: [productId], references: [id])
  productId    Int        @map("product_id")
  seller       Seller     @relation(fields: [sellerId], references: [id])
  sellerId     Int        @map("seller_id")
  
  price        Decimal    @db.Decimal(12, 2) @map("price")
  isAvailable  Boolean    @default(true) @map("is_available")
  scannedAt    DateTime   @default(now()) @map("scanned_at")

  deliveryRaw  String?    @map("delivery_raw") 
  deliveryDays Int?       @map("delivery_days")

  @@map("price_history")
}

model Review {
  id          Int       @id @default(autoincrement()) @map("id")
  product     Product   @relation(fields: [productId], references: [id])
  productId   Int       @map("product_id")
  
  authorName  String?   @map("author_name")
  rating      Int?      @map("rating")
  content     String?   @map("content")
  publishedAt DateTime? @map("published_at")
  hasPhotos   Boolean   @default(false) @map("has_photos")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("review")
}

model Role {
  id          Int      @id @default(autoincrement()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("role")
}

model User {
  id                Int                  @id @default(autoincrement()) @map("id")
  email             String               @unique @map("email")
  passwordHash      String               @map("password_hash")
  name              String?              @map("name")
  roleId            Int                  @map("role_id")
  role              Role                 @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  isVerified        Boolean              @default(false) @map("is_verified")
  verificationToken String?              @map("verification_token")
  refreshTokens     RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@map("user")
}

model RefreshToken {
  id         Int      @id @default(autoincrement()) @map("id")
  token      String   @unique @map("token")
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String?  @map("device_info")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("refresh_token")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement()) @map("id")
  token     String   @unique @map("token")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_token")
}